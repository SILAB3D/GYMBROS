// GymBros — esquema completo.
// El MVP usa un subconjunto; el resto de modelos (feed, logros, eventos)
// ya están definidos para que las fases 2+ no requieran migraciones dolorosas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Usuarios ----------

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  gymStartDate DateTime?
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())

  // Racha de SEMANAS cumpliendo el plan (weeklyTargetDays). Se reinicia si falla una semana.
  currentStreak      Int       @default(0) // semanas consecutivas
  bestStreak         Int       @default(0) // mejor racha histórica (semanas)
  lastCompletedWeek  DateTime? // lunes (ISO) de la última semana cumplida
  lastAttendanceDate DateTime?

  notifyPrefs Json @default("{}")

  // Posición actual dentro del plan de entrenamiento (índice del siguiente slot)
  planPosition Int @default(0)

  // Días de entrenamiento planificados por semana (0 = sin configurar)
  weeklyTargetDays Int @default(0)

  // Mostrar u ocultar el apartado de inversión
  investmentEnabled Boolean @default(true)

  // Tutorial de bienvenida ya completado
  onboardingDone Boolean @default(false)

  // El plan cambió automáticamente y conviene revisar el orden
  planNeedsReview Boolean @default(false)

  routines        Routine[]
  workouts        Workout[]
  attendances     Attendance[]
  personalRecords PersonalRecord[]
  bodyMetrics     BodyMetric[]
  pointEvents     PointEvent[]
  notifications   Notification[]
  achievements    UserAchievement[]
  feedItems       FeedItem[]
  feedLikes       FeedLike[]
  feedComments    FeedComment[]
  customExercises Exercise[]        @relation("CustomExercises")
  feedbacks       Feedback[]
  planSlots         PlanSlot[]
  chatMessages      ChatMessage[]
  chatReactions     ChatReaction[]
  pollVotes         PollVote[]
  pollSnoozes       PollSnooze[]
  pushSubscriptions PushSubscription[]
  gymSubscription   GymSubscription?

  lastChatReadAt DateTime? // para el contador de mensajes no leídos
}

// ---------- Ejercicios ----------

enum MuscleGroup {
  PECHO
  ESPALDA
  HOMBRO
  BICEPS
  TRICEPS
  PIERNA
  GLUTEO
  CORE
  CARDIO
  OTRO
}

model Exercise {
  id          String      @id @default(cuid())
  name        String
  muscleGroup MuscleGroup
  createdById String? // null = catálogo global
  createdBy   User?       @relation("CustomExercises", fields: [createdById], references: [id], onDelete: Cascade)

  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]
  personalRecords  PersonalRecord[]

  @@unique([name, createdById])
  @@index([muscleGroup])
}

// ---------- Rutinas ----------

model Routine {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  color            String   @default("#22c55e")
  emoji            String   @default("💪")
  recommendedDays  Int[]    @default([]) // (legado, ya no se usa en la UI)
  timesPerWeek     Int      @default(1) // cuántos días a la semana se hace esta rutina
  inPlan           Boolean  @default(true) // incluida en el plan de entrenamiento
  estimatedMinutes Int?
  isShared         Boolean  @default(false)
  clonedFromId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exercises RoutineExercise[]
  workouts  Workout[]
  planSlots PlanSlot[]

  @@index([userId])
  @@index([isShared])
}

model RoutineExercise {
  id           String   @id @default(cuid())
  routineId    String
  routine      Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  order        Int
  sets         Int      @default(3)
  reps         Int      @default(10)
  targetWeight Float?
  restSeconds  Int?     @default(90)
  notes        String?

  @@index([routineId])
}

// ---------- Entrenamientos ----------

model Workout {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId   String?
  routine     Routine?  @relation(fields: [routineId], references: [id], onDelete: SetNull)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  totalVolume Float     @default(0) // kg totales levantados
  totalSets   Int       @default(0)
  totalReps   Int       @default(0)
  notes       String?

  exercises WorkoutExercise[]

  @@index([userId, startedAt])
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  order      Int

  sets WorkoutSet[]

  @@index([workoutId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  reps              Int             @default(0)
  weight            Float           @default(0)
  completed         Boolean         @default(false)
  touched           Boolean         @default(false) // false = valor precargado de la sesión anterior
  notes             String?
}

// ---------- Asistencia ----------

model Attendance {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime  @db.Date
  checkIn  DateTime  @default(now())
  checkOut DateTime?
  gymName  String?
  notes    String?

  @@unique([userId, date])
  @@index([userId, date])
}

// ---------- PRs ----------

model PersonalRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  weight     Float
  reps       Int      @default(1)
  date       DateTime @default(now())
  notes      String?
  isAuto     Boolean  @default(false) // detectado automáticamente al registrar un entreno

  @@index([userId, exerciseId, date])
}

// ---------- Métricas privadas (NUNCA expuestas a otros usuarios) ----------

model BodyMetric {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  weightKg     Float?
  bodyFatPct   Float?
  muscleMassKg Float?
  bmi          Float?
  waistCm      Float?
  chestCm      Float?
  armCm        Float?
  legCm        Float?
  neckCm       Float?
  hipCm        Float?
  notes        String?
  photoUrl     String? // preparado para fotos de progreso (Supabase Storage, fase 2)

  @@index([userId, date])
}

// ---------- Puntos y ranking ----------

enum PointType {
  ATTENDANCE // ir al gimnasio
  WORKOUT_COMPLETED // completar rutina
  NEW_PR // nuevo récord
  STREAK_7 // racha de 7 días
  ROUTINE_SHARED // compartir rutina
  STREAK_WEEK1 // racha: 1 semana cumplida (+15)
  STREAK_WEEK2 // racha: 2 semanas seguidas (+25)
  STREAK_WEEK3 // racha: 3 semanas seguidas (+35)
  STREAK_MONTH // racha: 1 mes seguido (+45)
  STREAK_CRACK // crack: cada semana extra por encima del mes (+45)
  WEEKLY_TARGET // (legado)
  GOAL_COMPLETED // (legado)
  CUSTOM // regla personalizada otorgada por el admin
}

// Reglas de puntuación configurables desde el panel de admin.
// - type != null: regla estándar disparada automáticamente (puntos editables, se puede desactivar)
// - type == null: regla personalizada que el admin otorga manualmente a un usuario
model PointRule {
  id      String     @id @default(cuid())
  type    PointType? @unique
  name    String
  points  Int
  enabled Boolean    @default(true)
}

model PointEvent {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   PointType
  points Int
  date   DateTime  @default(now())
  meta   Json?

  @@index([userId, date])
  @@index([date])
}

// ---------- Notificaciones ----------

enum NotificationType {
  FRIEND_PR
  RANKING_CHANGE
  STREAK
  GOAL
  PR
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  meta      Json?

  @@index([userId, read, createdAt])
}

// ---------- Gamificación (fase 2: UI; el backend ya otorga logros) ----------

enum Rarity {
  COMUN
  RARO
  EPICO
  LEGENDARIO
}

model Achievement {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String
  icon        String  @default("🏆")
  rarity      Rarity  @default(COMUN)

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@id([userId, achievementId])
}

// ---------- Feed social (fase 2: likes/comentarios; los items ya se generan) ----------

enum FeedType {
  PR
  WORKOUT
  STREAK
  GOAL
  RANKING
  ROUTINE_SHARED
  ACHIEVEMENT
}

model FeedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      FeedType
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  likes    FeedLike[]
  comments FeedComment[]

  @@index([createdAt])
}

model FeedLike {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItemId String
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, feedItemId])
}

model FeedComment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItemId String
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now())
}

// ---------- Feedback de los usuarios (mejoras y bugs) ----------

enum FeedbackStatus {
  OPEN
  RESOLVED
}

model Feedback {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  status    FeedbackStatus @default(OPEN)
  createdAt DateTime       @default(now())

  @@index([status, createdAt])
}

// ---------- Plan de entrenamiento (orden/alternancia de rutinas y descansos) ----------

// Secuencia ordenada que define qué toca cada día de entrenamiento.
// routineId == null significa día de descanso.
model PlanSlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Int
  routineId String?
  routine   Routine? @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([userId, order])
}

// ---------- Chat de grupo ----------

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  reactions ChatReaction[]

  @@index([createdAt])
}

model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  @@unique([messageId, userId, emoji])
}

// ---------- Suscripciones push (un registro por dispositivo) ----------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Suscripción del gimnasio (calculadora de inversión) ----------

model GymSubscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate        DateTime // día del primer pago
  periodMonths     Int      @default(1) // 1=mensual, 2=bimestral, 3=trimestral…
  price            Float // precio por periodo
  autoRenew        Boolean  @default(false) // sin esto, cada renovación se confirma a mano
  confirmedPeriods Int      @default(1) // periodos pagados confirmados (incluye el inicial)
}

// ---------- Encuestas del admin ----------

model Poll {
  id          String    @id @default(cuid())
  title       String
  description String?
  options     String[]
  closed      Boolean   @default(false)
  publishAt   DateTime  @default(now()) // programación: ya / 22h / 10h
  notifiedAt  DateTime? // cuándo se avisó al grupo (null = pendiente)
  createdAt   DateTime  @default(now())

  votes   PollVote[]
  snoozes PollSnooze[]
}

// Aplazamientos de 30 min (máximo 3 por usuario y encuesta)
model PollSnooze {
  id     String    @id @default(cuid())
  pollId String
  poll   Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  count  Int       @default(0)
  until  DateTime?

  @@unique([pollId, userId])
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([pollId, userId])
}
