# --- Base de datos (Supabase > Project Settings > Database > Connection string) ---
# Usa el "Transaction pooler" (puerto 6543) para DATABASE_URL y el directo (5432) para DIRECT_URL
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto"
NEXTAUTH_URL="http://localhost:3000"

# --- Grupos ---
# Código del grupo original. Al migrar (npm run db:backfill-groups) se crea con
# este código, así que quien ya estaba dentro sigue entrando igual.
INVITE_CODE="GYMBROS2026"

# Clave maestra que hay que introducir para CREAR un grupo nuevo.
# Unirse a uno solo pide su código. Por defecto: 3333
GROUP_MASTER_KEY="3333"

# --- Notificaciones push (Web Push / VAPID) ---
# Genera un par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
